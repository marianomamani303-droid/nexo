# Ejemplo: XAMPP local detectado en el puerto 3307.
# Copiar a .env y completar SOLO localmente. No subir .env al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nexo_app
DB_PASSWORD=replace_with_your_local_password
DB_NAME=nexo_social


PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
NODE_ENV=development
HOST=127.0.0.1
SESSION_HOURS=24

# Account recovery and email verification. Mailpit uses 127.0.0.1:1025 locally.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=nexo@example.test

# Administrative credentials are only needed by scripts/migrate.ts --apply.
# Keep the runtime user restricted to SELECT, INSERT, UPDATE and DELETE.
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=
